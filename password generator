use std::io;
use rand::Rng;

struct PasswordConfig {
    length: u32,
    use_uppercase: bool,
    use_numbers: bool,
    use_symbols: bool,
}

impl PasswordConfig {
    fn generate_password(&mut self) -> String {
        println!("would you like to use uppercase in the password: y/n?");
        let mut input = String::new();
        io::stdin().read_line(&mut input).expect("failed to read");
        let input = input.trim().to_string();
        if input == "y" {
            self.use_uppercase = true;
        }

        println!("would you like to use numbers: y/n?");
        let mut input = String::new();
        io::stdin().read_line(&mut input).expect("failed to read");
        let input = input.trim().to_string();
        if input == "y" {
            self.use_numbers = true;
        }

        println!("would you like to use symbols?  y/n?");
        let mut input = String::new();
        io::stdin().read_line(&mut input).expect("failed to read");
        let input = input.trim().to_string();
        if input == "y" {
            self.use_symbols = true;
        }
        String::new()

       
    }

    fn compiler(&mut self) -> String {
        let mut generator = String::new();
        generator.push_str("abcdefghijklmnopqrstuvwxyz");

        if self.use_uppercase {
            generator.push_str("ABCDEFGHIJKLMNOPQRSTUVWXYZ");
        }
        if self.use_numbers {
            generator.push_str("0123456789");
        }
        if self.use_symbols {
            generator.push_str("!@#$%^&*()_+-=[]{}|;:,.<>?");
        }

        let generator: Vec<char> = generator.chars().collect();
        let mut rng = rand::thread_rng();
        
        let mut password = String::new();
        for _ in 0..self.length {
            let idx = rng.gen_range(0..generator.len());
            password.push(generator[idx]);
        }
        password
}
}
fn input(prompt: &str) -> String {
    let mut input = String::new();
    println!("{}", prompt);
    io::stdin().read_line(&mut input).expect("failed");
    input.trim().to_string()
}

fn main() {
    let length: u32 = input("password length:").parse().expect("invalid");

    let mut config = PasswordConfig {
        length,
        use_uppercase: false,
        use_numbers: false,
        use_symbols: false,
    };

    config.generate_password();
    println!("{}", config.compiler()); 
}
